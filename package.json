{
  "name": "autotrekker",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "pnpm --filter @autotrekker/scraper run scrape",
    "db:push": "pnpm --filter @autotrekker/db run push",
    "db:migrate": "pnpm --filter @autotrekker/db run migrate",
    "dev": "pnpm --filter @autotrekker/web run dev",
    "build": "pnpm --filter @autotrekker/web run build"
  }
}
